# Application Configuration
APP_NAME="Smart Restaurant Management System"
APP_ENV="development" # development, staging, production
DEBUG=true
API_V1_STR="/api/v1"
HOST="0.0.0.0"
PORT=8000

# Security & CORS
SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
ALLOWED_HOSTS=["localhost", "127.0.0.1", "0.0.0.0"]
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Database Configuration (PostgreSQL / Neon compatible)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/restaurant_db"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# Cache Configuration (Redis / Upstash compatible)
REDIS_URL="redis://localhost:6379/0"

# Storage Configuration (Cloudflare R2 Ready)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_DOMAIN=""

# Realtime Provider (Pusher / Ably Ready)
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER="mt1"

# Monitoring (Sentry Ready)
SENTRY_DSN=""

# Clerk Authentication (https://dashboard.clerk.com)
# Get these values from your Clerk dashboard → API Keys
CLERK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxx"
CLERK_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxx"
# Found at: Clerk Dashboard → API Keys → Advanced → JWKS URL
CLERK_JWKS_URL="https://your-instance.clerk.accounts.dev/.well-known/jwks.json"
# Found at: Clerk Dashboard → API Keys → Advanced → Issuer
CLERK_ISSUER="https://your-instance.clerk.accounts.dev"


# Logging (Better Stack Ready)
LOG_LEVEL="INFO"
LOG_FORMAT="json" # json or text
